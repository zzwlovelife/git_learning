####### Compile

db_client.o: ../../dbclient/src/db_client.cpp ../../dbclient/include/dbclient/db_client.h \
		../../dbclient/include/dbclient/dbclient_global.h \
		../../dbclient/include/dbclient/db_config.h \
		../../dbclient/include/dbclient/db_result.h \
		../../dbclient/src/db_client_p.h \
		../../dbclient/src/connection_pool.h \
		../../dbclient/src/scoped_connection.h \
		../../dbclient/src/error_classifier.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o db_client.o ../../dbclient/src/db_client.cpp

db_client_c.o: ../../dbclient/src/db_client_c.cpp ../../dbclient/include/dbclient/db_client_c.h \
		../../dbclient/include/dbclient/dbclient_global.h \
		../../dbclient/include/dbclient/db_client.h \
		../../dbclient/include/dbclient/db_config.h \
		../../dbclient/include/dbclient/db_result.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o db_client_c.o ../../dbclient/src/db_client_c.cpp

connection_pool.o: ../../dbclient/src/connection_pool.cpp ../../dbclient/src/connection_pool.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o connection_pool.o ../../dbclient/src/connection_pool.cpp

scoped_connection.o: ../../dbclient/src/scoped_connection.cpp ../../dbclient/src/scoped_connection.h \
		../../dbclient/src/connection_pool.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o scoped_connection.o ../../dbclient/src/scoped_connection.cpp

moc_connection_pool.o: moc_connection_pool.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_connection_pool.o moc_connection_pool.cpp

