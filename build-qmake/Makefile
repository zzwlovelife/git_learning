sub-lib-logger_shared-pro-distdir: FORCE
	@test -d lib/ || mkdir -p lib/
	cd lib/ && ( test -e Makefile.logger_shared || $(QMAKE) -o Makefile.logger_shared /workspace/lib/logger_shared.pro ) && $(MAKE) -e -f Makefile.logger_shared distdir DISTDIR=$(DISTDIR)/lib

